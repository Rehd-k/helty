# Facility identity for printed reports and the API.
# Copy this file to .env. Multi-value fields use `;` as the separator.
# ORG_LOGO is a Flutter asset path for PDFs, receipts, and the watermark.
# App chrome keeps assets/logo.png.
# APPINSTALLER_URL is build-time only. Copy it into pubspec.yaml
# msix_config appinstaller_url before packaging. msix does not read this file.
# API_BASE_URL: one origin, or a `;`-separated list. The fastest successful
# /server-time probe wins at startup.

ORG_NAME=
ORG_ADDRESSES=
ORG_PHONES=
ORG_EMAILS=
ORG_WEBSITE=
ORG_LOGO=
API_BASE_URL=
ORG_TAGLINES=
# APPINSTALLER_URL=
